  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python Debugger: Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal"
    },
    {
      "name": "Python Debugger: Main.py",
      "type": "debugpy",
      "request": "launch",
      "program": "./cs336_basics/main_decoding.py",
      "console": "integratedTerminal"
    },
    {
      "name": "Pytest whole file",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "tests/test_nn_utils.py"
      ],
    },
    {
      "name": "Pytest single",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "tests/test_nn_utils.py::test_cross_entropy"
      ],
    }
  ]
}